# Environment Variables Template for DocVision AI Platform

# Platform Environment & Execution
PROJECT_ENV=production
LOG_LEVEL=INFO
DEVICE=cuda

# FASTAPI Microservice Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Streamlit Studio Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# HuggingFace & Model Checkpoints
HF_HOME=~/.cache/huggingface
HF_AUTH_TOKEN=your_huggingface_api_token_here
CHECKPOINT_DIR=checkpoints

# Storage & Metrics Output Paths
DATA_DIR=data
OUTPUT_DIR=evaluation_results
LOG_FILE_PATH=logs/docvision.log
